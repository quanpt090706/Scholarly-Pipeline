# Copy thành .env để chạy: cp .env.example .env
OPENALEX_API_KEY=API_KEY
OPENALEX_MAILTO=your@email.com
OPENALEX_FILTER=institutions.country_code:VN,is_oa:true,publication_year:>2017
OPENALEX_BASE_URL=https://api.openalex.org
RAW_DIR=raw
PER_PAGE=200
SLEEP_SEC=0.15
MAX_RETRIES=5
# Test với 2 page trước: MAX_PAGES=2
MAX_PAGES=
# MinIO local (docker-compose)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=scholarly-raw
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
